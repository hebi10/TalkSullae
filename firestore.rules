rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function activeMember(roomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data.status == "active";
    }

    // Owner and membership mutations go through trusted callable Functions only.
    match /rooms/{roomId} {
      allow get: if activeMember(roomId);
      allow list, create, update, delete: if false;

      match /members/{userId} {
        allow get: if signedIn() && (request.auth.uid == userId || activeMember(roomId));
        allow list: if activeMember(roomId);
        allow create, update, delete: if false;
      }

      match /invites/{inviteId} {
        allow read, write: if false;
      }

      // Public room chat is read-only to active members.
      // Every write is server-authoritative via sendRoomMessage.
      match /messages/{messageId} {
        allow get: if activeMember(roomId)
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.status == "active";
        allow list: if activeMember(roomId)
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.status == "active"
          && request.query.limit != null && request.query.limit <= 30;
        allow create, update, delete: if false;
      }

      match /chatRateLimits/{userId} {
        allow read, write: if false;
      }

      // Public game session metadata only. Role/alias/ballot information
      // never belongs in these documents and cannot be read via Client SDK.
      match /gameSessions/{sessionId} {
        allow get: if activeMember(roomId)
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.status == "active";
        allow list: if activeMember(roomId)
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.status == "active"
          && request.query.limit != null && request.query.limit <= 10;
        allow create, update, delete: if false;

        // Anonymous public messages contain alias + text only, never a UID.
        // Read access requires the exact game's participant membership.
        match /publicMessages/{messageId} {
          allow get: if activeMember(roomId)
            && get(/databases/$(database)/documents/rooms/$(roomId)).data.status == "active"
            && get(/databases/$(database)/documents/rooms/$(roomId)/gameSessions/$(sessionId)).data.gameId in ["identity", "liar"]
            && get(/databases/$(database)/documents/rooms/$(roomId)/gameSessions/$(sessionId)).data.participants.keys().hasAny([request.auth.uid]);
          allow list: if activeMember(roomId)
            && get(/databases/$(database)/documents/rooms/$(roomId)).data.status == "active"
            && get(/databases/$(database)/documents/rooms/$(roomId)/gameSessions/$(sessionId)).data.gameId in ["identity", "liar"]
            && get(/databases/$(database)/documents/rooms/$(roomId)/gameSessions/$(sessionId)).data.participants.keys().hasAny([request.auth.uid])
            && request.query.limit != null && request.query.limit <= 30;
          allow create, update, delete: if false;
        }

        match /results/{resultId} {
          allow get: if activeMember(roomId)
            && get(/databases/$(database)/documents/rooms/$(roomId)).data.status == "active"
            && get(/databases/$(database)/documents/rooms/$(roomId)/gameSessions/$(sessionId)).data.phase == "finished";
          allow list: if false;
          allow create, update, delete: if false;
        }

        match /{privatePath=**} {
          allow read, write: if false;
        }
      }

      match /{other=**} {
        allow read, write: if false;
      }
    }

    match /userRooms/{userId} {
      allow read, write: if false;
      match /rooms/{roomId} {
        allow get, list: if signedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }
    }

    match /{other=**} {
      allow read, write: if false;
    }
  }
}
